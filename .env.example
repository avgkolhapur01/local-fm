# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# SQLite database file location (relative to server/)
DATABASE_PATH=./data/local-fm.sqlite

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# How long (ms) a stream "online/offline" check result is cached before
# it is re-checked. Keeps us from hammering broadcaster servers.
STREAM_CHECK_CACHE_MS=600000

# API request rate limit (requests per IP per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ── Client ────────────────────────────────────────────────────────────────
# Base URL of the backend API the client should call.
VITE_API_BASE_URL=http://localhost:4000/api

# Optional: reverse-geocoding provider used by useLocation/locationApi.
# This project ships with OpenStreetMap's free Nominatim endpoint, which
# needs NO key. Only set these if you swap in a different provider.
# VITE_GEOCODE_API_KEY=
